# Public defaults. Copy to .env for local overrides; .env is ignored.
DEMO_PORT=4200
DEMO_BIND_HOST=127.0.0.1
DEMO_REDIS_PORT=6387
DEMO_RATE_LIMIT=10
DEMO_RATE_WINDOW_MS=600000
# Exact Caddy source IP(s) or controlled proxy subnet(s), comma-separated.
# Empty means forwarded IP headers are ignored.
# The separate Coolify definition uses 1 for its single direct Traefik hop.
DEMO_TRUST_PROXY=
DEMO_RENDER_WORKERS=2
DEMO_RENDER_QUEUE=16
DEMO_RENDER_TIMEOUT_MS=10000
